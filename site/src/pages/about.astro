---
import Layout from '../layouts/Layout.astro';
import { getSnippets, getCategories } from '../lib/snippets';
import { highlight } from '../lib/highlight';

const snippets = await getSnippets();
const categories = getCategories(snippets).sort((a, b) => b.count - a.count);
const langs = new Set(snippets.map((s) => s.lang));
const totalLines = snippets.reduce((sum, s) => sum + s.lines, 0);

const contributors = (() => {
  const map = new Map<string, { name: string; avatar: string; count: number }>();
  for (const s of snippets) {
    for (const a of s.authors) {
      const c = map.get(a.email) ?? { name: a.name, avatar: a.avatar, count: 0 };
      c.count++;
      map.set(a.email, c);
    }
  }
  return [...map.values()].sort((a, b) => b.count - a.count);
})();

const total = snippets.length;
const PALETTE = ['#3b82f6', '#f97316', '#10b981', '#8b5cf6', '#ef4444', '#eab308', '#06b6d4', '#ec4899'];
const GAP = 0.6;

let acc = 25;
const segments = categories.map((c, i) => {
  const pct = (c.count / total) * 100;
  const seg = { ...c, color: PALETTE[i % PALETTE.length], pct, offset: acc };
  acc -= pct;
  return seg;
});

const maxCount = contributors[0]?.count ?? 1;
const contribRows = contributors.map((c, i) => ({
  ...c,
  rank: i + 1,
  ratio: (c.count / maxCount) * 100,
  share: (c.count / total) * 100,
}));

const tree = `pieces/
├── cpp/        # C++ 碎片
├── python/     # Python 碎片
├── md/         # Markdown 笔记
├── …           # 其他语言目录
└── site/       # 本站点源码（Astro）`;

const cmds = await highlight(
  `cd site
npm install
npm run dev      # 开发预览 http://localhost:4321/pieces/
npm run build    # 构建产物输出到 site/dist/
npm run preview  # 本地预览构建产物`,
  'bash',
);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<Layout title="关于 · 代码碎片" description="代码碎片 Code Pieces - 学习编程语言时积累的代码片段集合">
  <section class="about">
    <h1 class="about-title">关于本站</h1>
    <p class="about-sub">人人可以提交代码片段的网站。</p>

    <div class="about-stats">
      <div class="stat">
        <span class="stat-num">{snippets.length}</span>
        <span class="stat-label">碎片</span>
      </div>
      <div class="stat">
        <span class="stat-num">{categories.length}</span>
        <span class="stat-label">分类</span>
      </div>
      <div class="stat">
        <span class="stat-num">{langs.size}</span>
        <span class="stat-label">语言</span>
      </div>
      <div class="stat">
        <span class="stat-num">{totalLines.toLocaleString()}</span>
        <span class="stat-label">代码行</span>
      </div>
    </div>

      <section class="about-chart" aria-label="分类占比">
        <svg class="donut" viewBox="0 0 42 42" role="img" aria-label={`碎片分类占比，共 ${total} 个`}>
          <circle class="donut-track" cx="21" cy="21" r="15.9155" />
          {segments.map((s) => (
            <a href={`${base}/?cat=${s.dir}`}>
              <circle
                class="donut-seg"
                cx="21"
                cy="21"
                r="15.9155"
                stroke={s.color}
                stroke-dasharray={`${Math.max(s.pct - GAP, 0.4)} ${100 - Math.max(s.pct - GAP, 0.4)}`}
                stroke-dashoffset={s.offset}
              >
                <title>{`${s.label}：${s.count} 个（${s.pct.toFixed(1)}%）`}</title>
              </circle>
            </a>
          ))}
          <text class="donut-num" x="21" y="20.2">{total}</text>
          <text class="donut-label" x="21" y="24.5">碎片</text>
        </svg>
        <div class="chart-legend">
          {segments.map((s) => (
            <a class="about-cat" href={`${base}/?cat=${s.dir}`}>
              <span class="dot" style={`background:${s.color}`} />
              <span>{s.label}</span>
              <span class="about-cat-count">{s.count} · {s.pct.toFixed(1)}%</span>
            </a>
          ))}
        </div>
      </section>

    {contribRows.length > 0 && (
      <section class="contrib-board" aria-label="贡献者排行榜">
        <h2>贡献者排行榜</h2>
        <ol class="contrib-list">
          {contribRows.map((c) => (
            <li class="contrib-row">
              <span class={`contrib-rank${c.rank === 1 ? ' is-top' : ''}`}>{c.rank}</span>
              <img
                class="avatar avatar-lg"
                src={c.avatar}
                alt={c.name}
                loading="lazy"
                width="24"
                height="24"
                referrerpolicy="no-referrer"
              />
              <span class="contrib-name">{c.name}</span>
              <span class="contrib-bar">
                <i style={`width:${c.ratio}%`} />
              </span>
              <span class="contrib-count">{c.count} 个 · {c.share.toFixed(1)}%</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <p>
      「代码碎片 Code Pieces」是我在学习编程语言过程中积累下来的代码片段集合：某个语法的行为验证、某个坑的复现、某个写法的对比测试。仓库里每个源码文件就是一个碎片——片段即目录，文件即卡片，站点构建时自动扫描收录，无需手动登记。
    </p>

    <section class="about-submit">
      <h2>提交你的碎片</h2>
      <p class="submit-desc">
        在提交页填写分类、文件名和代码，机器人会自动创建 Pull
        Request，审核合并后碎片就会出现在本站。
      </p>
      <a class="submit-btn" href={`${base}/submit/`}>去提交碎片 →</a>
    </section>

  </section>
</Layout>
