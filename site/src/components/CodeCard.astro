---
import type { Snippet } from '../lib/snippets';
import { tagLabel } from '../lib/snippets';
import Authors from './Authors.astro';
import { highlight, truncateLines } from '../lib/highlight';

interface Props {
  snippet: Snippet;
}

const { snippet } = Astro.props;
const { text, truncated } = truncateLines(snippet.code);
const preview = await highlight(text, snippet.lang);
const date = snippet.date;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<article class="card" data-slug={snippet.slug}>
  <div class="card-head">
    <h2 class="card-title">
      <a href={`${base}/snippet/${snippet.slug}/`}>{snippet.name}</a>
    </h2>
    <span class="card-tags">
      {snippet.tags.map((t, i) => (
        <a class:list={['badge', i === 0 && `badge-${snippet.lang}`, i > 0 && 'badge-sub']} href={`${base}/?tag=${t}`}>
          {tagLabel(t)}
        </a>
      ))}
    </span>
  </div>
  {snippet.desc && <p class="card-desc">{snippet.desc}</p>}
  <div class:list={['card-preview', truncated && 'is-truncated']}>
    <div set:html={preview} />
  </div>
  <div class="card-foot">
    <span class="card-foot-meta">
      <Authors authors={snippet.authors} />
      <span>{snippet.lines} 行 · {date}</span>
    </span>
    <a class="more" href={`${base}/snippet/${snippet.slug}/`}>查看完整代码 →</a>
  </div>
</article>
